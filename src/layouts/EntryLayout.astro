---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  date: Date;
  primaryTag?: string;
  summary?: string;
  collectionPath: string;
};

const { title, date, primaryTag, summary, collectionPath } = Astro.props;
const collection = collectionPath.split("/")[1];
const collectionLabel = { projects: "Projects", photos: "Photos", music: "Music" }[collection];

// const dateFormatter = new Intl.DateTimeFormat("en-US", {
//   year: "numeric",
//   month: "short",
//   day: "numeric",
//   timeZone: "UTC"
// });
---

<BaseLayout title={`${title} | alexzhu.io`} canonicalPath={collectionPath}>
  <main class="page-content entry-content">
    <p class="entry-kicker">
      <a href={`/${collection}/`}>
        {collectionLabel}
      </a>
      <span> / </span>
      {title}
      <span> / </span>
      {primaryTag}
    </p>
    {summary && <p class="entry-summary">{summary}</p>}
    <slot />
  </main>
</BaseLayout>
