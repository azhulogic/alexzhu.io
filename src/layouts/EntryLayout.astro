---
import BaseLayout from "./BaseLayout.astro";
import "katex/dist/katex.min.css";

type Props = {
  title: string;
  primaryTag?: string;
  summary?: string;
  collectionPath: string;
};

const { title, primaryTag, summary, collectionPath } = Astro.props;
const collection = collectionPath.split("/")[1];
const collectionLabel = { projects: "Projects", travel: "Travel", music: "Music" }[collection];

---

<BaseLayout title={`${title} | alexzhu.io`} canonicalPath={collectionPath}>
  <main class="page-content entry-content">
    <p class="entry-kicker">
      <a href={`/${collection}/`}>
        {collectionLabel}
      </a>
      <span> / </span>
      {title}
      <span> / </span>
      {primaryTag}
    </p>
    <hr class="entry-divider" />
    {summary && <p class="entry-summary">{summary}</p>}
    <slot />
  </main>
</BaseLayout>

<style>
  .entry-content {
    margin-top: 0.5rem;
  }

  .entry-content .entry-kicker {
    margin-top: 0;
  }

  .entry-divider {
    border: 0;
    border-top: 1px solid #e6e6e6;
    margin: 0.75rem 0 1.5rem;
  }

  .entry-content :global(.katex-display) {
    overflow-x: auto;
    padding-block: 0.25rem;
  }
</style>
