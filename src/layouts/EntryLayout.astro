---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  date: Date;
  summary?: string;
  collectionPath: string;
};

const { title, date, summary, collectionPath } = Astro.props;
---

<BaseLayout title={`${title} | alexzhu.io`} canonicalPath={collectionPath}>
  <main class="page-content entry-content">
    <p class="entry-kicker">
      <a href={collectionPath.startsWith("/projects") ? "/projects/" : "/photos/"}>
        {collectionPath.startsWith("/projects") ? "Projects" : "Photos"}
      </a>
      <span> / </span>
      <time datetime={date.toISOString()}>{date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric"
      })}</time>
    </p>
    <h1>{title}</h1>
    {summary && <p class="entry-summary">{summary}</p>}
    <slot />
  </main>
</BaseLayout>
