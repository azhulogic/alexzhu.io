---
import BaseLayout from "./BaseLayout.astro";
import "../styles/logbook-table.css";

interface Props {
  active: "flying" | "mountains" | "diving";
}
const { active } = Astro.props;
const tabs = [
  { id: "flying", label: "Flying", href: "/logbook/" },
  { id: "mountains", label: "Mountains", href: "/logbook/mountains/" },
  { id: "diving", label: "Diving", href: "/logbook/diving/" }
];
const current = tabs.find((tab) => tab.id === active)!;
---

<BaseLayout title={`${current.label} | Logbook | alexzhu.io`} canonicalPath={current.href}>
  <main class="page-content logbook-page">
    <header class="logbook-header">
      <h1>Logbook</h1>
      <nav class="logbook-tabs" aria-label="Logbook categories">
        {tabs.map((tab) => (
          <a href={tab.href} aria-current={tab.id === active ? "page" : undefined}>{tab.label}</a>
        ))}
      </nav>
    </header>
    <slot />
  </main>
</BaseLayout>

<style>
  .logbook-page { --ink-accent: #365b65; width: min(100%, 62rem); margin-top: 2.5rem; margin-bottom: 4rem; }
  .logbook-header { margin-bottom: 2rem; }
  .logbook-header h1 { font-size: clamp(2.25rem, 7vw, 3.25rem); letter-spacing: -0.045em; margin: 0 0 1rem; }
  .logbook-tabs { display: flex; gap: clamp(1.25rem, 5vw, 2rem); border-bottom: 1px solid #dedede; }
  .logbook-tabs a { padding: 0.65rem 0 0.8rem; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--soft); font-size: 0.9rem; }
  .logbook-tabs a[aria-current="page"] { color: var(--text); border-bottom-color: var(--ink-accent); font-weight: 700; }
  .logbook-tabs a:hover { color: var(--text); text-decoration: none; }
  .logbook-tabs a:focus-visible { outline: 2px solid var(--ink-accent); outline-offset: 4px; }
  @media (max-width: 40rem) {
    .logbook-page { margin-top: 0.5rem; }
  }
</style>
