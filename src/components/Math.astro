---
import katex from "katex";
import "katex/dist/katex.min.css";

interface Props {
  tex: string;
  display?: boolean;
}

const { tex, display = false } = Astro.props;
const html = katex.renderToString(tex, {
  displayMode: display,
  throwOnError: true,
  trust: false
});
---

<span class:list={["math", { "math-display": display }]} set:html={html} />

<style>
  .math-display {
    display: block;
    overflow-x: auto;
    padding-block: 0.25rem;
  }
</style>
