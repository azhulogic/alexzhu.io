---
type Entry = {
  id: string;
  data: {
    title: string;
    date: Date;
    primaryTag?: string;
    summary?: string;
    tags?: string[];
    draft?: boolean;
  };
};

type Props = {
  entries: Entry[];
  basePath: "/projects" | "/travel" | "/music";
  emptyText: string;
};

const { entries, basePath, emptyText } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC"
});
---

{
  entries.length > 0 ? (
    <ol class="entry-list">
      {entries.map((entry) => (
        <li>
          <a href={`${basePath}/${entry.id}/`}>
            <span>{entry.data.title}{entry.data.draft && " (Draft)"}</span>
            <time datetime={entry.data.date.toISOString()}>
              {entry.data.primaryTag ?? dateFormatter.format(entry.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <p>{emptyText}</p>
  )
}
