---
type Entry = {
  slug: string;
  data: {
    title: string;
    date: Date;
    summary?: string;
    tags?: string[];
  };
};

type Props = {
  entries: Entry[];
  basePath: "/projects" | "/photos";
  emptyText: string;
};

const { entries, basePath, emptyText } = Astro.props;
---

{
  entries.length > 0 ? (
    <ol class="entry-list">
      {entries.map((entry) => (
        <li>
          <a href={`${basePath}/${entry.slug}/`}>
            <span>{entry.data.title}</span>
            <time datetime={entry.data.date.toISOString()}>
              {entry.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric"
              })}
            </time>
          </a>
          {entry.data.summary && <p>{entry.data.summary}</p>}
        </li>
      ))}
    </ol>
  ) : (
    <p>{emptyText}</p>
  )
}
