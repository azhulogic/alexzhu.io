<style>
  .globe-demo {
    margin: 2rem auto;
    text-align: center;
  }

  #travel-globe-chart {
    width: min(100%, 36rem);
    height: 520px;
    margin: 0 auto 2rem;
  }

  .globe-demo h2 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    line-height: 1.2;
  }

  .globe-note {
    margin: 0;
    color: var(--soft);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  @media (max-width: 35rem) {
    #travel-globe-chart {
      height: 420px;
    }
  }
</style>
