---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryList from "../../components/EntryList.astro";

const entries = (await getCollection("projects"))
  .filter((entry) => !entry.data.draft || import.meta.env.SHOW_PROJECT_DRAFTS === "true")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects | alexzhu.io" canonicalPath="/projects/">
  <main class="page-content entry-index">
    <EntryList entries={entries} basePath="/projects" emptyText="Nothing here... yet." />
  </main>
</BaseLayout>
