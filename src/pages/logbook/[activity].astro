---
import LogbookLayout from "../../layouts/LogbookLayout.astro";
import mountains from "../../data/mountains.json";

export function getStaticPaths() {
  return [
    { params: { activity: "mountains" }, props: {
      active: "mountains" as const,
      stats: ["Summits", "Highest summit", "Elevation gained"],
      heading: "Summit records",
      columns: ["Date", "Mountain", "Location", "Summit elevation (ft)", "Elevation gain", "Route", "Notes"],
      rows: mountains.map((mountain) => [mountain.date, mountain.name, mountain.location, mountain.elevationFt.toLocaleString("en-US"), "?", "?", mountain.status]),
      emptyText: "Mountains climbed and summit notes will appear here."
    } },
    { params: { activity: "diving" }, props: {
      active: "diving" as const,
      stats: ["Dives", "Time underwater", "Deepest dive"],
      heading: "Dive records",
      columns: ["Date", "Dive site", "Location", "Max depth", "Duration", "Notes"],
      rows: [] as string[][],
      emptyText: "Scuba dives and underwater notes will appear here."
    } }
  ];
}

const { active, stats, heading, columns, rows, emptyText } = Astro.props;
---

<LogbookLayout active={active}>
  <section class="activity-summary" aria-label={active === "mountains" ? "Climbing totals" : "Diving totals"}>
    {stats.map((label: string) => (
      <div><span>{label}</span><strong aria-label="Not yet recorded">—</strong></div>
    ))}
  </section>

  <section class="activity-records" aria-labelledby="records-title">
    <h2 id="records-title">{heading}</h2>
    <div class="table-scroll" tabindex="0" role="region" aria-label={`${heading}; scroll horizontally for all columns`}>
      <table>
        <caption class="sr-only">{heading}</caption>
        <thead><tr>{columns.map((label: string, index: number) => <th scope="col" class:list={[{ numeric: index === 3 || index === 4 }]}>{label}</th>)}</tr></thead>
        <tbody>
          {rows.length > 0 ? rows.map((row: string[]) => (
            <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td class:list={[{ numeric: index === 3 || index === 4 }]}>{cell}</td>)}</tr>
          )) : <tr><td colspan={columns.length} class="empty-records">{emptyText}</td></tr>}
        </tbody>
      </table>
    </div>
  </section>
</LogbookLayout>

<style>
  .activity-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding: 1.5rem 0 2rem; border-bottom: 1px solid #dedede; }
  .activity-summary span { display: block; font-size: 0.8rem; color: var(--muted); }
  .activity-summary strong { display: block; margin-top: 0.5rem; font-size: clamp(2rem, 6vw, 3rem); font-weight: 400; color: var(--soft); }
  .activity-records { margin-top: 3rem; }
  .activity-records h2 { margin: 0 0 1.25rem; font-size: 1.125rem; letter-spacing: -0.02em; }
  .empty-records { padding: 2.5rem 1rem; text-align: center; color: var(--soft); line-height: 1.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
